generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ContentStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  REJECTED
  SCHEDULED
  PUBLISHED
  FAILED
}

enum TemplateKind {
  INSTITUTIONAL
  NEWS
  TEAM_PHOTO
  CREDIT_EXPLAINER
  VIDEO_THUMB
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         String    @default("EDITOR")
  createdAt    DateTime  @default(now())
  contents     Content[] @relation("Author")
  events       AuditEvent[]
}

model Profile {
  id             String    @id @default(cuid())
  slug           String    @unique
  name           String
  description    String    @default("")
  audience       String    @default("")
  voice          String    @default("")
  ctas           String[]  @default([])
  permittedTerms String[]  @default([])
  primaryColor   String    @default("#2e52f0")
  secondaryColor String    @default("#101b40")
  fontHeading    String    @default("Arial")
  fontBody       String    @default("Arial")
  logoUrl        String?
  driveFolderId  String?
  driveFolderKey String?
  brandFolderId  String?
  brandFolderKey String?
  instagramId    String?
  formats        String[]  @default(["3:4", "9:16"])
  contents       Content[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Template {
  id        String       @id @default(cuid())
  kind      TemplateKind @unique
  name      String
  version   Int          @default(1)
  width     Int          @default(1080)
  height    Int          @default(1440)
  fields    Json
  contents  Content[]
}

model Content {
  id          String        @id @default(cuid())
  profileId   String
  templateId  String
  authorId    String
  title       String
  topic       String
  objective   String        @default("")
  body        String        @default("")
  caption     String        @default("")
  sourceUrl   String?
  sourceDate  DateTime?
  photoUrl    String?
  slides      Json?
  status      ContentStatus @default(DRAFT)
  version     Int           @default(1)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  profile     Profile       @relation(fields: [profileId], references: [id])
  template    Template      @relation(fields: [templateId], references: [id])
  author      User          @relation("Author", fields: [authorId], references: [id])
  revisions   Revision[]
  publications Publication[]
  events      AuditEvent[]
}

model Revision {
  id        String   @id @default(cuid())
  contentId String
  version   Int
  snapshot  Json
  createdAt DateTime @default(now())
  content   Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  @@unique([contentId, version])
}

model MediaAsset {
  id           String   @id @default(cuid())
  url          String
  origin       String
  name         String
  approved     Boolean  @default(false)
  picturedName String?
  width        Int?
  height       Int?
  createdAt    DateTime @default(now())
}

model Publication {
  id          String   @id @default(cuid())
  contentId   String
  network     String   @default("instagram")
  accountId   String?
  scheduledAt DateTime?
  publishedAt DateTime?
  status      String   @default("PENDING")
  externalId  String?
  error       String?
  content     Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)
}

model AuditEvent {
  id        String   @id @default(cuid())
  contentId String
  userId    String
  action    String
  detail    Json?
  createdAt DateTime @default(now())
  content   Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])
}

model PortalSource {
  id            String @id @default(cuid())
  slug          String @unique
  name          String
  homepageUrl   String
  feedUrl       String? @unique
  enabled       Boolean @default(true)
  lastCheckedAt DateTime?
  lastSuccessAt DateTime?
  lastError     String?
  articles      SourceArticle[]
}

model SourceArticle {
  id          String @id @default(cuid())
  portalId    String
  title       String
  url         String @unique
  summary     String
  publishedAt DateTime
  foundAt     DateTime @default(now())
  portal      PortalSource @relation(fields: [portalId], references: [id], onDelete: Cascade)
  @@index([publishedAt])
}
